{
  "name": "grimoire3d-root",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js apps/studio",
    "build": "node node_modules/vite/bin/vite.js build apps/studio",
    "test": "node node_modules/vitest/vitest.mjs run",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4"
  }
}
